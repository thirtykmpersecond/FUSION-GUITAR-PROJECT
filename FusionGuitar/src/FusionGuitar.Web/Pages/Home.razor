@page "/"
@using FusionGuitar.Web.Theory

<section class="space-y-10">
    <header class="card p-8 md:p-10">
        <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center shadow-pop shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                    <path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
                </svg>
            </div>
            <div>
                <h1 class="text-2xl md:text-3xl font-semibold tracking-tight text-slate-900 dark:text-white">
                    Fusion 电吉他乐理
                </h1>
                <p class="text-slate-500 dark:text-slate-400 mt-2 max-w-2xl">
                    系统的 Fusion / Jazz 乐理教材，配合交互式指板图、钢琴键盘、和弦图与音频示范。
                    中文讲解，术语附英文对照。
                </p>
            </div>
        </div>
    </header>

    <section>
        <h2 class="text-lg font-semibold text-slate-800 dark:text-slate-100 mb-4">快速开始</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <a href="fretboard" class="card p-5 hover:shadow-pop transition">
                <div class="text-brand-600 mb-2">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16M4 4v16M4 12h16M20 4v16"/></svg>
                </div>
                <div class="font-medium">指板图</div>
                <div class="text-sm text-slate-500 mt-1">可视化音阶、琶音与把位</div>
            </a>
            <a href="piano" class="card p-5 hover:shadow-pop transition">
                <div class="text-brand-600 mb-2">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 18V6h18v12M9 6v9M15 6v9"/></svg>
                </div>
                <div class="font-medium">钢琴键盘</div>
                <div class="text-sm text-slate-500 mt-1">从键盘理解音程与和弦</div>
            </a>
            <a href="lessons/01-basics" class="card p-5 hover:shadow-pop transition">
                <div class="text-brand-600 mb-2">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/></svg>
                </div>
                <div class="font-medium">基础夯实</div>
                <div class="text-sm text-slate-500 mt-1">从音程与三和弦开始</div>
            </a>
        </div>
    </section>

    <section class="card p-6 md:p-8">
        <h2 class="text-lg font-semibold mb-4 text-slate-800 dark:text-slate-100">CAGED：C 大调音阶（开放把位预览）</h2>
        <Fretboard Notes="@cMajorNotes" Frets="12" />
    </section>
</section>

@code {
    private IReadOnlyList<FretNote> cMajorNotes = Array.Empty<FretNote>();

    protected override void OnInitialized()
    {
        var fb = new GuitarFretboard();
        var scale = new Scale(Note.Parse("C4"), ScaleFormulas.Major);
        cMajorNotes = fb.FindScale(scale, 0, 12);
    }
}
