@inject LessonService Lessons
@inject ProgressService Progress
@implements IDisposable

<div class="px-5 py-6">
    <div class="flex items-center gap-2 mb-8">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center shadow-soft">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                <path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
            </svg>
        </div>
        <div>
            <div class="font-semibold text-slate-900 dark:text-white text-[15px] leading-tight">Fusion Guitar</div>
            <div class="text-xs text-slate-500">电吉他乐理教材</div>
        </div>
    </div>

    <nav class="space-y-4">
        <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12l9-9 9 9M5 10v10h14V10"/></svg>
            <span>首页</span>
        </NavLink>

        <div>
            <div class="px-3 pb-1 text-[11px] uppercase tracking-wider text-slate-400 font-medium">工具</div>
            <div class="space-y-1">
                <NavLink class="nav-item" href="fretboard">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16M4 4v16M4 12h16M20 4v16"/></svg>
                    <span>指板图</span>
                </NavLink>
                <NavLink class="nav-item" href="piano">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18V6h18v12M9 6v9M15 6v9"/></svg>
                    <span>钢琴键盘</span>
                </NavLink>
                <NavLink class="nav-item" href="circle">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 3v18M3 12h18"/></svg>
                    <span>五度圈</span>
                </NavLink>
                <NavLink class="nav-item" href="harmony">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8 11l8-4M8 13l8 4"/></svg>
                    <span>和声地图</span>
                </NavLink>
                <NavLink class="nav-item" href="notation">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                    <span>乐谱演示</span>
                </NavLink>
                <NavLink class="nav-item" href="voicings">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3l4 4M16 3l-4 4M8 21l4-4M16 21l-4-4M3 8l4 4M3 16l4-4M21 8l-4 4M21 16l-4-4"/></svg>
                    <span>Drop 和弦</span>
                </NavLink>
                <NavLink class="nav-item" href="progressions">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                    <span>和弦进行</span>
                </NavLink>
            </div>
        </div>

        @if (_manifest is not null)
        {
            foreach (var mod in _manifest.Modules.OrderBy(m => m.Order))
            {
                <div>
                    <div class="px-3 pb-1 text-[11px] uppercase tracking-wider text-slate-400 font-medium flex items-center justify-between">
                        <span>@mod.Title</span>
                        @{
                            var count = mod.Lessons.Count;
                            var done = mod.Lessons.Count(l => _completed.Contains(l.Slug));
                        }
                        @if (count > 0)
                        {
                            <span class="text-[10px] normal-case tracking-normal text-slate-400">@done/@count</span>
                        }
                    </div>
                    <div class="space-y-1">
                        @foreach (var lesson in mod.Lessons.OrderBy(l => l.Order))
                        {
                            <NavLink class="nav-item !py-1.5 !text-[13px]"
                                     href="@($"/lessons/{mod.Id}/{lesson.Slug}")"
                                     ActiveClass="active">
                                <span class="w-4 text-center text-[11px] opacity-60">
                                    @(_completed.Contains(lesson.Slug) ? "✓" : lesson.Order.ToString())
                                </span>
                                <span class="truncate">@lesson.Title</span>
                            </NavLink>
                        }
                    </div>
                </div>
            }
        }
    </nav>
</div>

@code {
    private LessonManifest? _manifest;
    private HashSet<string> _completed = new();

    protected override async Task OnInitializedAsync()
    {
        Progress.Changed += OnProgressChanged;
        _manifest = await Lessons.GetManifestAsync();
        _completed = await Progress.GetCompletedAsync();
    }

    private async void OnProgressChanged()
    {
        _completed = await Progress.GetCompletedAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Progress.Changed -= OnProgressChanged;
}

<style>
    .nav-item {
        display: flex; align-items: center; gap: .65rem;
        padding: .5rem .75rem; border-radius: .75rem;
        font-size: .875rem; color: rgb(51 65 85);
        transition: background-color .15s ease;
    }
    :global(.dark) .nav-item { color: rgb(203 213 225); }
    .nav-item:hover { background: rgb(241 245 249); text-decoration: none; }
    :global(.dark) .nav-item:hover { background: rgb(30 41 59); }
    .nav-item.active {
        background: rgb(224 231 255); color: rgb(55 48 163); font-weight: 500;
    }
    :global(.dark) .nav-item.active { background: rgb(49 46 129 / .5); color: rgb(199 210 254); }
</style>
