@inherits LayoutComponentBase
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@implements IDisposable

<div class="min-h-screen flex flex-col md:flex-row bg-slate-50 dark:bg-slate-950">
    <!-- Mobile top bar -->
    <header class="md:hidden sticky top-0 z-40 flex items-center justify-between px-4 h-14
                   bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border-b border-slate-200/70 dark:border-slate-800">
        <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center shadow-soft">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-white">
                    <path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
                </svg>
            </div>
            <div>
                <div class="font-semibold text-slate-900 dark:text-white text-sm leading-tight">Fusion Guitar</div>
                <div class="text-[11px] text-slate-500">电吉他乐理教材</div>
            </div>
        </div>
        <button class="p-2 rounded-lg text-slate-600 dark:text-slate-300" @onclick="() => _menuOpen = !_menuOpen"
                aria-label="菜单" aria-expanded="@_menuOpen">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                @if (_menuOpen)
                {
                    <path d="M18 6L6 18M6 6l12 12"/>
                }
                else
                {
                    <path d="M3 6h18M3 12h18M3 18h18"/>
                }
            </svg>
        </button>
    </header>

    <aside class="@(_menuOpen ? "block" : "hidden") md:block
                  md:w-64 md:min-h-screen md:border-r border-slate-200/70 dark:border-slate-800
                  bg-white/70 dark:bg-slate-900/60 backdrop-blur-xl
                  md:sticky md:top-0 md:h-screen overflow-y-auto
                  fixed inset-x-0 top-14 bottom-0 z-30 shadow-soft md:shadow-none">
        <NavMenu />
    </aside>

    <main class="flex-1 min-w-0">
        <div class="max-w-6xl mx-auto px-4 md:px-8 py-6 md:py-10">
            @Body
        </div>
    </main>
</div>

@code {
    private bool _menuOpen;
    private EventHandler<Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs>? _onNav;

    protected override void OnInitialized()
    {
        _onNav = (_, _) => _menuOpen = false;
        Nav.LocationChanged += _onNav;
    }

    public void Dispose()
    {
        if (_onNav is not null) Nav.LocationChanged -= _onNav;
    }
}
