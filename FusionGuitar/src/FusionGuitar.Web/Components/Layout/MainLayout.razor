@inherits LayoutComponentBase

<div class="min-h-screen flex flex-col md:flex-row bg-slate-50 dark:bg-slate-950">
    <aside class="md:w-64 md:min-h-screen md:border-r border-slate-200/70 dark:border-slate-800
                  bg-white/70 dark:bg-slate-900/60 backdrop-blur-xl
                  md:sticky md:top-0 md:h-screen overflow-y-auto">
        <NavMenu />
    </aside>

    <main class="flex-1 min-w-0">
        <div class="max-w-6xl mx-auto px-4 md:px-8 py-6 md:py-10">
            @Body
        </div>
    </main>
</div>
