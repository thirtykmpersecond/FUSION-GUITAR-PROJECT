@inject Interop.NotationInterop NotationJs
@implements IAsyncDisposable

<div id="@_id" class="@Class" style="min-height:@(_height)px; overflow-x:auto;"></div>

@code {
    private static int _counter;
    private readonly string _id = $"vex-{System.Threading.Interlocked.Increment(ref _counter)}";
    private readonly Interop.NotationEvents _events = new();
    private DotNetObjectReference<Interop.NotationEvents>? _eventsRef;
    private int _height = 170;
    private bool _firstRender = true;
    private int _lastHash;

    [Parameter] public IReadOnlyList<NotationNote> Notes { get; set; } = Array.Empty<NotationNote>();
    [Parameter] public IReadOnlyList<TabNote> TabNotes { get; set; } = Array.Empty<TabNote>();
    [Parameter] public string Clef { get; set; } = "treble";
    [Parameter] public string? TimeSignature { get; set; }
    [Parameter] public string? KeySignature { get; set; }
    [Parameter] public int Width { get; set; } = 540;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public EventCallback<int> OnNoteClick { get; set; }
    [Parameter] public int? HighlightedIndex { get; set; }

    protected override void OnInitialized()
    {
        _events.NoteClicked += idx => InvokeAsync(async () =>
        {
            if (OnNoteClick.HasDelegate) await OnNoteClick.InvokeAsync(idx);
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var hash = HashNotes();
        if (_firstRender || hash != _lastHash)
        {
            _firstRender = false;
            _lastHash = hash;
            _height = (TabNotes?.Count > 0) ? 300 : 170;
            await Task.Yield();
            try
            {
                _eventsRef ??= DotNetObjectReference.Create(_events);
                await NotationJs.RenderStaveAsync(_id, Width, Clef, TimeSignature, KeySignature, Notes, TabNotes, _eventsRef);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Notation] render failed: {ex.Message}");
            }
        }
        if (HighlightedIndex is int hi)
        {
            await NotationJs.HighlightNoteAsync(_id, hi, "#ef4444");
        }
        else
        {
            await NotationJs.ClearHighlightAsync(_id);
        }
    }

    private int HashNotes()
    {
        var h = new HashCode();
        h.Add(Clef); h.Add(TimeSignature); h.Add(KeySignature); h.Add(Width);
        foreach (var n in Notes)
        {
            h.Add(n.Duration);
            foreach (var k in n.Keys) h.Add(k);
        }
        foreach (var t in TabNotes)
        {
            h.Add(t.Duration);
            foreach (var p in t.Positions) { h.Add(p.String); h.Add(p.Fret); }
        }
        return h.ToHashCode();
    }

    public async ValueTask DisposeAsync()
    {
        _eventsRef?.Dispose();
        _eventsRef = null;
    }
}
