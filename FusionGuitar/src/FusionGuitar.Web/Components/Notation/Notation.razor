@inject Interop.NotationInterop NotationJs

<div id="@_id" class="@Class" style="min-height:160px; overflow-x:auto;"></div>

@code {
    private static int _counter;
    private readonly string _id = $"vex-{System.Threading.Interlocked.Increment(ref _counter)}";
    private bool _firstRender = true;
    private int _lastHash;

    [Parameter] public IReadOnlyList<NotationNote> Notes { get; set; } = Array.Empty<NotationNote>();
    [Parameter] public string Clef { get; set; } = "treble";
    [Parameter] public string? TimeSignature { get; set; }
    [Parameter] public string? KeySignature { get; set; }
    [Parameter] public int Width { get; set; } = 520;
    [Parameter] public string Class { get; set; } = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var hash = HashNotes();
        if (_firstRender || hash != _lastHash)
        {
            _firstRender = false;
            _lastHash = hash;
            await Task.Yield();
            try
            {
                await NotationJs.RenderStaveAsync(_id, Width, Clef, TimeSignature, KeySignature, Notes);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Notation] render failed: {ex.Message}");
            }
        }
    }

    private int HashNotes()
    {
        var h = new HashCode();
        h.Add(Clef); h.Add(TimeSignature); h.Add(KeySignature); h.Add(Width);
        foreach (var n in Notes)
        {
            h.Add(n.Duration);
            foreach (var k in n.Keys) h.Add(k);
        }
        return h.ToHashCode();
    }
}
